rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user-scoped data: a user can only read, create, update, or delete their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Explicitly deny access to any collections outside /users
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
